# Copy this file to .env.local and fill in your values
# NEVER commit .env.local — it is gitignored

# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Google Sheets ──
GOOGLE_SHEET_ID=your_google_sheet_id
# Paste the full service account JSON as a single line
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com",...}

# ── Google Sheets CSV URLs (public read — from File > Share > Publish to web) ──
NEXT_PUBLIC_SHEET_URL_WORKOUTS=https://docs.google.com/spreadsheets/d/e/YOUR_SHEET_ID/pub?gid=0&single=true&output=csv
NEXT_PUBLIC_SHEET_URL_NUTRITION=https://docs.google.com/spreadsheets/d/e/YOUR_SHEET_ID/pub?gid=NUTRITION_GID&single=true&output=csv
NEXT_PUBLIC_SHEET_URL_BRICKS=https://docs.google.com/spreadsheets/d/e/YOUR_SHEET_ID/pub?gid=BRICKS_GID&single=true&output=csv
NEXT_PUBLIC_SHEET_URL_PROGRESS=https://docs.google.com/spreadsheets/d/e/YOUR_SHEET_ID/pub?gid=PROGRESS_GID&single=true&output=csv
NEXT_PUBLIC_SHEET_URL_SLEEP=https://docs.google.com/spreadsheets/d/e/YOUR_SHEET_ID/pub?gid=SLEEP_GID&single=true&output=csv
NEXT_PUBLIC_SHEET_URL_MOBILITY=https://docs.google.com/spreadsheets/d/e/YOUR_SHEET_ID/pub?gid=MOBILITY_GID&single=true&output=csv

# ── Strava ──
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret
NEXT_PUBLIC_STRAVA_REDIRECT_URI=https://your-app.vercel.app/api/strava/callback
# For local dev, use: http://localhost:3000/api/strava/callback

# ── App URL ──
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
# For local dev: NEXT_PUBLIC_APP_URL=http://localhost:3000
